## SSL Configuration below

# Replace the Code below if You wish to Automatically redirect http->https
# server {
#     listen 80;
#     listen [::]:80;
#     server_name _;
#
#     # Redirect HTTP to HTTPS
#     return 301 https://$host$request_uri;
# }


server {
    listen 80;
    listen [::]:80;
    
    # Log Files
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    root /var/www/public;
    index index.php index.html;
    
    location ~ \.php$ {
        try_files $uri =404;

        # Change the 'app' to whatever the name of your 
        # php container name on your docker-compose file
        fastcgi_pass app:9000;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }
    
    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }
}



server {
    listen 443 ssl;
    listen [::]:443 ssl;
    
    server_name _;  # Catch-all for IP or other domain names

    # SSL certificate and key
    ssl_certificate /etc/ssl/live/${FQDN}/fullchain.pem;  # Path to your SSL certificate
    ssl_certificate_key /etc/ssl/live/${FQDN}/privkey.pem;  # Path to your SSL key

    # Optional: SSL configurations for better security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;



    # Log Files
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    root /var/www/public;
    index index.php index.html;
    
    location ~ \.php$ {
        try_files $uri =404;

        # Change the 'app' to whatever the name of your 
        # php container name on your docker-compose file
        fastcgi_pass app:9000;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }
    
    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }
}
